// Generic strict Object-A fiber over Q(b,c), using the compact graph model.
option(redSB);
option(prot);
ring R=(0,b,c),(s,u,v,z),dp;
poly one=1;
poly p=u^3+v^3;
poly dd=v^3-u^3;
poly D4=one-4*p+4*b*s*dd;
poly Nnum=4*s^2*dd+4*s^3*p-s^3+b-4*b*s^3*p-4*b*s^4*dd;
poly Xn=-Nnum;
poly Xd=s^3*D4;
poly Yn=Xd-Xn;
poly Z=b*Xd+Yn;
poly AA=c*Yn+4*b*c*p*Xd+4*b*c*Yn*s*dd-2*b*Xn*D4;
poly Pd=8*c*Z;
poly Qn=AA*Xd+2*Xn*D4*Z;
poly Qd=Pd*Xd;
poly Tn=one-u^2*(one-s)^2;
poly BA=u^2*Xn^2+Tn*Yn^2;
poly BH=u^2*s^2*Xn^2+Tn*Xd^2;
poly FF=AA^2*BA^3-Xn^6*Pd^2*u^6;
poly GG=Qn^2*BH^3-Xn^6*Qd^2*u^6;
poly graph=4*s*u^2*v^2-u^2+v^2;
poly loc=u*v*(u^2-v^2);
ideal I=graph,FF,GG,z*loc-1;
print("BEGIN_OBJECTA_GENERIC");
print("FF_terms="+string(size(FF)));
print("GG_terms="+string(size(GG)));
ideal G=std(I);
print("generic_dimension="+string(dim(G)));
print("generic_degree="+string(vdim(G)));
print("generic_groebner_size="+string(size(G)));
print("GENERIC_GROEBNER_BASIS");
G;
print("END_OBJECTA_GENERIC");
quit;
