// Physical (++ root) Object-A tangent-critical Groebner cover.
LIB "grobcov.lib";
option(redSB);
ring R=(0,b,c),(s,u,v,r,k,ds,du,dv,dr,dk,z),dp;
poly p=u^3+v^3;
poly dd=v^3-u^3;
poly D4=1-4*p+4*b*s*dd;
poly Nnum=4*s^2*dd+4*s^3*p-s^3+b-4*b*s^3*p-4*b*s^4*dd;
poly Xn=-Nnum;
poly Xd=s^3*D4;
poly Yn=Xd-Xn;
poly Z=b*Xd+Yn;
poly A1=Yn+4*b*p*Xd+4*b*Yn*s*dd;
poly Tn=1-u^2*(1-s)^2;
poly BA=u^2*Xn^2+Tn*Yn^2;
poly BH=u^2*s^2*Xn^2+Tn*Xd^2;
poly graph=4*s*u^2*v^2-u^2+v^2;
poly r2=r^2-BA;
poly k2=k^2-BH;
poly cross=A1*r^3*k^3-8*Xn^3*u^3*(Yn*k^3+b*Xd*r^3);
poly MA=4*c*s^3*Xn^2*u^3*(r^3-k^3)-r^3*k^3;
poly t1=diff(graph,s)*ds+diff(graph,u)*du+diff(graph,v)*dv+diff(graph,r)*dr+diff(graph,k)*dk;
poly t2=diff(r2,s)*ds+diff(r2,u)*du+diff(r2,v)*dv+diff(r2,r)*dr+diff(r2,k)*dk;
poly t3=diff(k2,s)*ds+diff(k2,u)*du+diff(k2,v)*dv+diff(k2,r)*dr+diff(k2,k)*dk;
poly t4=diff(cross,s)*ds+diff(cross,u)*du+diff(cross,v)*dv+diff(cross,r)*dr+diff(cross,k)*dk;
poly tm=diff(MA,s)*ds+diff(MA,u)*du+diff(MA,v)*dv+diff(MA,r)*dr+diff(MA,k)*dk;
poly a11=diff(graph,s); poly a12=diff(graph,u); poly a13=diff(graph,v); poly a14=diff(graph,r); poly a15=diff(graph,k);
poly a21=diff(r2,s); poly a22=diff(r2,u); poly a23=diff(r2,v); poly a24=diff(r2,r); poly a25=diff(r2,k);
poly a31=diff(k2,s); poly a32=diff(k2,u); poly a33=diff(k2,v); poly a34=diff(k2,r); poly a35=diff(k2,k);
poly a41=diff(cross,s); poly a42=diff(cross,u); poly a43=diff(cross,v); poly a44=diff(cross,r); poly a45=diff(cross,k);
poly b11=a11; poly b12=a13; poly b13=a14; poly b14=a15;
poly b21=a21; poly b22=a23; poly b23=a24; poly b24=a25;
poly b31=a31; poly b32=a33; poly b33=a34; poly b34=a35;
poly b41=a41; poly b42=a43; poly b43=a44; poly b44=a45;
poly cof=b11*(b22*(b33*b44-b34*b43)-b23*(b32*b44-b34*b42)+b24*(b32*b43-b33*b42))-b12*(b21*(b33*b44-b34*b43)-b23*(b31*b44-b34*b41)+b24*(b31*b43-b33*b41))+b13*(b21*(b32*b44-b34*b42)-b22*(b31*b44-b34*b41)+b24*(b31*b42-b32*b41))-b14*(b21*(b32*b43-b33*b42)-b22*(b31*b43-b33*b41)+b23*(b31*b42-b32*b41));
poly edge=b*c*(2*b+c)*(2*b+c+2)*(4*c-1)*(4*c+1)*(b-4*c)*(b+4*c)*(2*b-c)*(b^3-c*(b+1)^2)*(b^3+c*(b+1)^2)*((b*c-b-c)^2-4*b*c)*((b*c-b+c)^2+4*b*c)*((b*c+b-c)^2+4*b*c)*((b*c+b+c)^2-4*b*c);
poly Delta=edge*u*v*(u^2-v^2)*r*k*Xn*D4*Z*cof;
ideal I=graph,r2,k2,cross,MA,t1,t2,t3,t4,du-1,tm,z*Delta-1;
print("BEGIN_ROOTSHEET_u");
print("cross_terms="+string(size(cross)));
print("cofactor_terms="+string(size(cof)));
list GC=grobcov(I,"rep",2,"comment",2);
print("segment_count="+string(size(GC)));
GC;
print("END_ROOTSHEET_u");
quit;
