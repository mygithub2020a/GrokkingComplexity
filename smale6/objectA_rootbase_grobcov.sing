// Base-curve dimension cover for the physical (++ root) Object-A sheet.
LIB "grobcov.lib";
option(redSB);
ring R=(0,b),(s,u,v,r,k,z),dp;
poly p=u^3+v^3;
poly dd=v^3-u^3;
poly D4=1-4*p+4*b*s*dd;
poly Nnum=4*s^2*dd+4*s^3*p-s^3+b-4*b*s^3*p-4*b*s^4*dd;
poly Xn=-Nnum;
poly Xd=s^3*D4;
poly Yn=Xd-Xn;
poly Z=b*Xd+Yn;
poly A1=Yn+4*b*p*Xd+4*b*Yn*s*dd;
poly Tn=1-u^2*(1-s)^2;
poly BA=u^2*Xn^2+Tn*Yn^2;
poly BH=u^2*s^2*Xn^2+Tn*Xd^2;
poly graph=4*s*u^2*v^2-u^2+v^2;
poly r2=r^2-BA;
poly k2=k^2-BH;
poly cross=A1*r^3*k^3-8*Xn^3*u^3*(Yn*k^3+b*Xd*r^3);
poly Delta=b*u*v*(u^2-v^2)*r*k*Xn*D4*Z;
ideal I=graph,r2,k2,cross,z*Delta-1;
print("BEGIN_ROOTBASE");
print("cross_terms="+string(size(cross)));
list GC=grobcov(I,"rep",2,"comment",2);
print("segment_count="+string(size(GC)));
GC;
print("END_ROOTBASE");
quit;
